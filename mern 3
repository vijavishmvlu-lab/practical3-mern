# (c) Declare variables and write a function to calculate the sum of two numbers

```jsx
function App() {
  const num1 = 20;
  const num2 = 30;

  function add(a, b) {
    return a + b;
  }

  return (
    <div>
      <h2>Sum of Two Numbers</h2>
      <p>{num1} + {num2} = {add(num1, num2)}</p>
    </div>
  );
}

export default App;
```

